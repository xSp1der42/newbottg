# Секреты
.env

# Виртуальные окружения
venv/
env/
.venv/

# Кэш питона
__pycache__/
*.pyc

# Временные видео (вход/выход рендера)
videos/*
!videos/.keep

# Тестовые файлы и кадры
_smoke/
_tune/
_peek/

# Реальные баннеры брендов - не коммитим (защищены авторским правом).
# Структуру папок держим через .gitkeep
banners/**/*
!banners/*/
!.gitkeep

# ОС
.DS_Store
Thumbs.db
