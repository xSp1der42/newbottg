# Секреты
.env

# Виртуальные окружения
venv/
env/
.venv/

# Кэш питона
__pycache__/
*.pyc

# Временные видео (вход/выход рендера)
videos/*
!videos/.keep

# Тестовые файлы и кадры
_smoke/
_tune/
_peek/

# Баннеры брендов коммитим - без них бот на Render не найдёт файлы
# (файловая система контейнера эфемерная, руками на сервер не закинешь).
banners/**
!banners/**/
!banners/**/*.mp4
!banners/**/*.png
!banners/**/*.jpg
!banners/**/*.webp
!banners/**/*.gif
!.gitkeep

# ОС
.DS_Store
Thumbs.db
